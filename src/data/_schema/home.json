{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src/data/home.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes for whoever edits this file. Ignored when the site is built."
    },
    "headings": {
      "type": "object",
      "properties": {
        "welcome": {
          "type": "string"
        },
        "vision": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "banners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "description": "Picture, written as /data/images/... (leave the word \"public\" out)."
          },
          "link": {
            "type": "string",
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          },
          "align": {
            "type": "string"
          },
          "max_height": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "description": "Width in pixels. Leave it out to use the default."
          },
          "height": {
            "type": "number",
            "description": "Height in pixels. Leave it out to use the default."
          }
        },
        "additionalProperties": false
      }
    },
    "marquee": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The wording people read."
          },
          "link_text": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          },
          "badge": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "description": "The line of text at the top."
        },
        "new_badge": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "description": "Picture, written as /data/images/... (leave the word \"public\" out)."
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "initiatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "description": "Picture, written as /data/images/... (leave the word \"public\" out)."
          },
          "link": {
            "type": "string",
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          },
          "width": {
            "type": "number",
            "description": "Width in pixels. Leave it out to use the default."
          }
        },
        "additionalProperties": false
      }
    },
    "tours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The wording people read."
          },
          "image": {
            "type": "string",
            "description": "Picture, written as /data/images/... (leave the word \"public\" out)."
          },
          "link": {
            "type": "string",
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
