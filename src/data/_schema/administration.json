{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src/data/administration.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes for whoever edits this file. Ignored when the site is built."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name, as it should appear on the card."
          },
          "photo": {
            "type": "string",
            "description": "Portrait file name, uploaded to public/data/images/."
          },
          "designation": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Job title. One line, or a list of lines."
          },
          "contact": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "description": "Written as \"name at iiitkottayam dot ac.in\" so spam robots cannot collect it."
              },
              "phone": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "One number, or a list of them."
              },
              "room": {
                "type": "string",
                "description": "Room number, e.g. AC 301."
              }
            },
            "additionalProperties": false,
            "description": "Phone, room and email shown at the bottom of the card."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
