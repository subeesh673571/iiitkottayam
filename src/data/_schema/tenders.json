{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src/data/tenders.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes for whoever edits this file. Ignored when the site is built."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The wording people read."
          },
          "status": {
            "type": "number",
            "description": "Tenders: 1 = live, 2 = closed, 3 = cancelled. Nothing else is shown. Elsewhere: above 0 shows the NEW badge."
          },
          "lastDate": {
            "type": "string",
            "description": "Closing date, exactly as you want it shown."
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The wording people read."
                },
                "link": {
                  "type": "string",
                  "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
                },
                "title": {
                  "type": "string",
                  "description": "The wording people read."
                }
              },
              "additionalProperties": false
            },
            "description": "One or more documents to link from this row."
          },
          "extendedDate": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
