{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src/data/news.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes for whoever edits this file. Ignored when the site is built."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The wording people read."
          },
          "link": {
            "type": "string",
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          },
          "new": {
            "type": "boolean",
            "description": "true shows the animated NEW badge beside this item."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
