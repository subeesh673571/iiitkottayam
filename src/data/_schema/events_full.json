{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src/data/events_full.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_help": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes for whoever edits this file. Ignored when the site is built."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The wording people read."
          },
          "description": {
            "type": "string",
            "description": "A sentence or two under the heading."
          },
          "photo": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "posx": {
                "type": "string"
              },
              "posy": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "Portrait file name, uploaded to public/data/images/."
          },
          "date": {
            "type": "string",
            "description": "Shown under the description, exactly as you type it."
          },
          "link": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "The wording people read."
                },
                "link": {
                  "type": "string",
                  "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
                },
                "target": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "description": "Where it goes: a page path like /placement, a file like /data/pdf/x.pdf, or a full https:// address."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
